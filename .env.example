# Copy to .env.local for local development. Never commit real values.
# Only this file is tracked; .env.local and every other .env.* file are git-ignored.
# Vercel: set these in Project Settings → Environment Variables with the scopes noted below.
# Full guide: docs/deployment-workflow.md
#
# Legend:  [public] safe in the browser   [secret] server only, never prefix with NEXT_PUBLIC_

# ── Site ────────────────────────────────────────────────
# [public] Canonical site URL, no trailing slash (canonical links, sitemap, Open Graph).
# Local: http://localhost:3000 · Preview: the develop preview URL · Production: your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sanity (public read configuration) ──────────────────
# [public] Without a project ID the site renders the local fallback content in lib/content/fallback.ts.
# Scopes: Development, Preview, Production.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# [public] Dataset this environment READS (and the embedded /studio edits). Production = "production".
# Preview should use a separate dataset once one exists (see docs/deployment-workflow.md).
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# [secret] Shared secret for the Sanity webhook that calls /api/revalidate. Production only.
SANITY_REVALIDATE_SECRET=

# ── YouTube (recent uploads, no API key) ────────────────
# [public] Channel ID: starts with "UC", 24 characters (not the @handle).
# YouTube Studio → Settings → Channel → Advanced settings. Scopes: Preview, Production.
YOUTUBE_CHANNEL_ID=

# ── Contact form (Resend) ───────────────────────────────
# Without all three the form validates input and honestly reports that it cannot send yet.
# Scope: Production only (leave unset in Preview so previews can never send email).
# [secret]
RESEND_API_KEY=
# Inbox that receives messages.
CONTACT_TO_EMAIL=
# Verified sender in Resend, e.g. "Taher Fawaz site <contact@your-domain>".
CONTACT_FROM_EMAIL=

# ── Never in Vercel or in the app ───────────────────────
# SANITY_API_WRITE_TOKEN is used only by one-off local import scripts (git-ignored) and must not be set
# in Vercel. Editorial work goes through the authenticated Studio or the Sanity MCP (OAuth).
